# Desarrollo (SQLite)
DATABASE_URL="file:./dev.db"

# Cambiar por una cadena aleatoria larga en cualquier entorno compartido.
AUTH_SECRET="cambie-esta-clave-por-una-de-al-menos-32-caracteres"

# Credencial creada por el seed. Nunca conserve estos valores en producción.
ADMIN_USER="admin"
ADMIN_PASSWORD="Cambiar123!"

# URL pública usada al construir los QR impresos.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# filesystem en desarrollo. La interfaz StorageAdapter permite implementar s3/blob.
STORAGE_DRIVER="filesystem"

# Producción Vercel + Supabase: use Transaction Pooler para el tráfico de la app
