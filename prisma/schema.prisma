generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TipoDesafio {
  CHECK_IN
  OPCION_MULTIPLE
  RESPUESTA_ABIERTA
  EVIDENCIA_FOTO
  ENCUESTA
}

enum EstadoDesafio {
  BORRADOR
  PUBLICADO
  CERRADO
}

enum EstadoCompletitud {
  APROBADO
  PENDIENTE
  RECHAZADO
}

enum ModoAsistentes {
  MOSAICO
  CARRUSEL
  DESTACADO
}

model Participante {
  id                  String               @id @default(cuid())
  nombre              String
  nombres             String?
  apellidos           String?
  empresaId           String
  equipoId            String?
  urlFoto             String
  codigoRecuperacion  String               @unique
  puntosRegistro      Int                  @default(0)
  puntosTotales       Int                  @default(0)
  activo              Boolean              @default(true)
  esStaff             Boolean              @default(false)
  creadoEn            DateTime             @default(now())
  empresa             Empresa              @relation(fields: [empresaId], references: [id])
  equipo              Equipo?               @relation(fields: [equipoId], references: [id], onDelete: SetNull)
  completitudes       Completitud[]
  recuerdos           Recuerdo[]
  reaccionesRecuerdos ReaccionRecuerdo[]
  ajustes             AjustePuntos[]
  sesiones            SesionParticipante[]
  correoAutorizado    CorreoAutorizado?
  respuestasActividad RespuestaActividad[]
  actividadesCompletadas ParticipacionActividad[]

  @@index([puntosTotales])
  @@index([activo, esStaff, puntosTotales])
  @@index([empresaId])
  @@index([equipoId])
}

model CorreoAutorizado {
  id             String        @id @default(cuid())
  correo         String        @unique
  participanteId String?       @unique
  equipoId       String?
  creadoEn       DateTime      @default(now())
  participante   Participante? @relation(fields: [participanteId], references: [id], onDelete: SetNull)
  equipo         Equipo?       @relation(fields: [equipoId], references: [id], onDelete: SetNull)

  @@index([creadoEn])
  @@index([equipoId])
}

model Equipo {
  id              String              @id @default(cuid())
  nombre          String              @unique
  orden           Int
  activo          Boolean             @default(true)
  participantes   Participante[]
  autorizaciones  CorreoAutorizado[]

  @@index([orden])
}

model Empresa {
  id            String         @id @default(cuid())
  nombre        String         @unique
  urlLogo       String?
  orden         Int
  activa        Boolean        @default(true)
  participantes Participante[]

  @@index([orden])
}

model Componente {
  id       String    @id @default(cuid())
  nombre   String    @unique
  orden    Int
  colorHex String
  activo   Boolean   @default(true)
  desafios Desafio[]

  @@index([orden])
}

model Ubicacion {
  id     String  @id @default(cuid())
  nombre String  @unique
  orden  Int
  activa Boolean @default(true)

  @@index([orden])
}

model Desafio {
  id                  String        @id @default(cuid())
  codigoQr            String        @unique
  titulo              String
  descripcion         String
  tipo                TipoDesafio
  puntos              Int
  dia                 Int
  componenteId        String?
  ubicacion           String
  estado              EstadoDesafio @default(BORRADOR)
  esSecreto           Boolean       @default(false)
  disponibleDesde     DateTime?
  disponibleHasta     DateTime?
  duracionMinutos     Int?          @default(60)
  publicadoEn         DateTime?
  limiteCompletitudes Int?
  configuracion       Json
  urlImagen           String?
  creadoEn            DateTime      @default(now())
  componente          Componente?   @relation(fields: [componenteId], references: [id])
  completitudes       Completitud[]

  @@index([estado, dia])
  @@index([componenteId])
}

model Completitud {
  id              String            @id @default(cuid())
  participanteId  String
  desafioId       String
  puntosOtorgados Int
  respuesta       Json?
  urlEvidencia    String?
  estado          EstadoCompletitud @default(APROBADO)
  completadoEn    DateTime          @default(now())
  participante    Participante      @relation(fields: [participanteId], references: [id], onDelete: Cascade)
  desafio         Desafio           @relation(fields: [desafioId], references: [id], onDelete: Cascade)

  @@unique([participanteId, desafioId])
  @@index([participanteId])
  @@index([desafioId])
  @@index([estado])
}

model Actividad {
  id                 String                  @id @default(cuid())
  titulo             String
  tipo               String                  @default("GUIADA")
  codigoAcceso       String?                 @unique
  anonima            Boolean                 @default(false)
  requiereEmpresa    Boolean                 @default(false)
  invitacion         String
  cierre             String
  estado             String                  @default("BORRADOR")
  pasoActual         Int                     @default(0)
  puntosHabilitados  Boolean                 @default(false)
  puntos             Int                     @default(0)
  configuracion      Json
  creadoEn           DateTime                @default(now())
  actualizadoEn      DateTime                @updatedAt
  respuestas         RespuestaActividad[]
  participaciones    ParticipacionActividad[]

  @@index([estado, creadoEn])
}

model RespuestaActividad {
  id              String       @id @default(cuid())
  actividadId     String
  participanteId String
  preguntaId      String
  empresaEvaluadaId String?
  respuesta       Json
  respondidoEn    DateTime     @default(now())
  actividad       Actividad    @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  participante    Participante @relation(fields: [participanteId], references: [id], onDelete: Cascade)

  @@unique([actividadId, participanteId, preguntaId])
  @@index([actividadId, preguntaId])
  @@index([participanteId])
  @@index([empresaEvaluadaId])
}

model ParticipacionActividad {
  id              String       @id @default(cuid())
  actividadId     String
  participanteId String
  puntosOtorgados Int          @default(0)
  completadaEn    DateTime     @default(now())
  actividad       Actividad    @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  participante    Participante @relation(fields: [participanteId], references: [id], onDelete: Cascade)

  @@unique([actividadId, participanteId])
  @@index([participanteId])
}

model Recuerdo {
  id                String             @id @default(cuid())
  participanteId    String
  urlFoto           String
  urlMiniatura      String
  descripcion       String?
  visible           Boolean            @default(true)
  reportado         Boolean            @default(false)
  pendiente         Boolean            @default(false)
  creadoEn          DateTime           @default(now())
  claveIdempotencia String?            @unique
  participante      Participante       @relation(fields: [participanteId], references: [id], onDelete: Cascade)
  reacciones        ReaccionRecuerdo[]

  @@index([creadoEn])
  @@index([participanteId])
}

model ReaccionRecuerdo {
  id             String       @id @default(cuid())
  recuerdoId     String
  participanteId String
  tipo           String
  creadoEn       DateTime     @default(now())
  recuerdo       Recuerdo     @relation(fields: [recuerdoId], references: [id], onDelete: Cascade)
  participante   Participante @relation(fields: [participanteId], references: [id], onDelete: Cascade)

  @@unique([recuerdoId, participanteId, tipo])
  @@unique([recuerdoId, participanteId])
  @@index([recuerdoId, tipo])
  @@index([participanteId])
}

model AjustePuntos {
  id             String       @id @default(cuid())
  participanteId String
  puntos         Int
  motivo         String
  adminId        String
  creadoEn       DateTime     @default(now())
  participante   Participante @relation(fields: [participanteId], references: [id], onDelete: Cascade)
  admin          Admin        @relation(fields: [adminId], references: [id])

  @@index([participanteId])
}

model Admin {
  id                   String         @id @default(cuid())
  usuario              String         @unique
  passwordHash         String
  intentosFallidos     Int            @default(0)
  ultimoIntentoFallido DateTime?
  bloqueadoHasta       DateTime?
  creadoEn             DateTime       @default(now())
  ajustes              AjustePuntos[]
  sesiones             SesionAdmin[]
}

model LimiteSolicitud {
  id        String   @id @default(cuid())
  accion    String
  claveHash String
  ventana   DateTime
  cantidad  Int      @default(1)
  expiraEn  DateTime

  @@unique([accion, claveHash, ventana])
  @@index([expiraEn])
}

model SesionParticipante {
  id             String       @id @default(cuid())
  tokenHash      String       @unique
  participanteId String
  expiraEn       DateTime
  creadoEn       DateTime     @default(now())
  participante   Participante @relation(fields: [participanteId], references: [id], onDelete: Cascade)

  @@index([participanteId])
  @@index([expiraEn])
}

model SesionAdmin {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  adminId   String
  expiraEn  DateTime
  creadoEn  DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([expiraEn])
}

model ConfiguracionEvento {
  id                           String         @id @default("evento")
  nombreEvento                 String         @default("Pasaporte")
  descripcionAgenda            String         @default("")
  organizadoresAgenda          String         @default("Vicepresidencia Experiencia Usuario-Cliente")
  diplomaHabilitado            Boolean        @default(false)
  tamanoPodioIndividual        Int            @default(5)
  puntosPorRegistro            Int            @default(10)
  puntosPorRecuerdo            Int            @default(10)
  maxRecuerdosConPuntos        Int            @default(1)
  revisionPuntosRecuerdo       Int            @default(0)
  maxRecuerdosPorParticipante  Int            @default(10)
  eliminarEvidenciasRechazadas Boolean        @default(true)
  recuerdosRequierenAprobacion Boolean        @default(false)
  puntosFotoMasReaccionada     Int            @default(0)
  revisionPremioReacciones     Int            @default(0)
  modoAsistentes               ModoAsistentes @default(MOSAICO)
  intervaloAsistentesSegundos  Int            @default(6)
  cicloMixto                   String         @default("asistentes:60,recuerdos:45,podio:30")
  rotacionAutomaticaProyeccion Boolean        @default(true)
}

model DiaAgenda {
  id       String          @id @default(cuid())
  nombre   String
  fecha    String?
  orden    Int
  momentos MomentoAgenda[]
  fotos    FotoDiaAgenda[]

  @@index([orden])
}

model FotoDiaAgenda {
  id      String    @id @default(cuid())
  diaId   String
  urlFoto String
  orden   Int       @default(1)
  dia     DiaAgenda @relation(fields: [diaId], references: [id], onDelete: Cascade)

  @@index([diaId, orden])
}

model MomentoAgenda {
  id               String    @id @default(cuid())
  diaId            String
  horaInicio       String
  horaFin          String
  nombre           String
  descripcion      String
  destacado        Boolean   @default(false)
  urlFotoExpositor String?
  dia              DiaAgenda @relation(fields: [diaId], references: [id], onDelete: Cascade)

  @@index([diaId, horaInicio])
}
